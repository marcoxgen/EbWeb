@model PubblicazioneBudgetListViewModel

<div class="mb-2">
    <div class="row align-items-center mb-3">
        <div class="col-lg-8 d-flex align-items-center">
            <h3 class="mb-0 me-3">@ViewData["Title"]</h3>
            <a asp-action="Create" asp-controller="AlimentazioneBudget" class="btn btn-outline-success">
                <i class="fas fa-plus"></i> Crea nuova
            </a>
        </div>
    </div>

    <form asp-action="Index" method="get">
        <div class="bg-light border py-2">
            <div class="row text-center g-0 mx-0 px-2 fw-semibold" style="font-size: 0.75rem;">
                <div class="col-lg-2">Tipo</div>
                <div class="col-lg-1">Data Riferimento</div>
                <div class="col-lg-1">Stato</div>
                <div class="col-lg-2">Ultima Lavorazione</div>
                <div class="col-lg-3">Note Pubblicazione</div>
                <div class="col-lg-1"></div>
            </div>
        </div>
    </form>

    @foreach (PubblicazioneBudgetViewModel pubblicazione in Model.PubblicazioniBudget.Results)
    {
        <div class="row g-0 border-bottom py-1 align-items-center mx-0 px-2">
            <div class="col-lg-2">
                <span>@pubblicazione.TipoPubblicazioneDes</span>
            </div>
            <div class="col-lg-1 text-center">
                <span>@pubblicazione.DataRiferimento</span>
            </div>
            <div class="col-lg-1 text-center">
                <span>@pubblicazione.FlagStato</span>
            </div>
            <div class="col-lg-2 text-center">
                <span>@pubblicazione.DataUltimaLavorazione</span>
            </div>
            <div class="col-lg-3 text-center">
                <div class="note-inline-container" data-id="@pubblicazione.IdPubblicazione" style="position: relative; cursor: pointer; min-height: 30px;">
                    <span class="note-text">@pubblicazione.Note</span>
                    <i class="fas fa-pencil-alt text-muted edit-icon d-none" style="margin-left: 8px; font-size: 0.8rem;"></i>
                </div>
            </div>
            <div class="col-lg-1 d-flex justify-content-center align-items-center">
                <div class="dropdown">
                    <button class="btn btn-light btn-sm text-secondary rounded-pill px-3 border"
                        type="button"
                        id="dropdown-@pubblicazione.IdPubblicazione"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        style="height: 26px; padding-top: 0; padding-bottom: 0; line-height: 1; display: inline-flex; align-items: center;">
                        <i class="fas fa-ellipsis-h"></i>
                    </button>

                    <div class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="dropdown-@pubblicazione.IdPubblicazione">
                        <a class="dropdown-item py-2" asp-action="Azioni" asp-route-id="@pubblicazione.IdPubblicazione">
                            <i class="fas fa-cogs text-muted me-2 small"></i> Gestisci   Azioni
                        </a>

                        <div class="dropdown-divider my-1"></div>

                        <a class="dropdown-item text-danger py-2" href="#"
                            data-bs-toggle="modal"
                            data-bs-target="#modalConfermaElimina"
                            onclick="$('#idPubblicazioneInput').val('@pubblicazione.IdPubblicazione')">
                            <i class="fas fa-trash-alt me-2 small"></i> Elimina Pubblicazione
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalConfermaElimina" tabindex="-1" aria-labelledby="modalEliminaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminaLabel"><i class="fas fa-exclamation-triangle me-2"></i>Conferma Eliminazione</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="DeletePubblicazione" method="post">
                <div class="modal-body text-center p-4">
                    <p class="fs-5 mb-1 fw-bold text-dark">Sei sicuro di voler procedere?</p>
                    <p class="text-muted small">L'eliminazione della pubblicazione e di tutte le azioni collegate è irreversibile.</p>

                    <input type="hidden" name="idPubblicazione" id="idPubblicazioneInput" />
                </div>
                <div class="modal-footer justify-content-center border-top-0">
                    <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">Annulla</button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash-alt me-1"></i> Elimina
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>