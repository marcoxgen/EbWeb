@model List<ControlloThanos2ViewModel>

<div class="mb-2">
    <div class="row align-items-center mb-3">
        <div class="col-lg-8 d-flex align-items-center">
            <h3 class="mb-0 me-3">@ViewData["Title"]</h3>
        </div>
    </div>

    <form asp-action="Index" method="get">
        <div class="bg-light border py-2">
            <div class="row text-center g-0 mx-0 px-2 fw-semibold">
                <div class="col-lg-8">Anomalia</div>
                <div class="col-lg-1">Nr Anomalie</div>
                <div class="col-lg-1">Ultimo Aggiornamento</div>
                <div class="col-lg-1"></div>
            </div>
        </div>
    </form>

    @foreach (ControlloThanos2ViewModel controllo in Model)
    {
        <div class="row g-0 border-bottom py-1 align-items-center mx-0 px-2 @controllo.RowCssClass">
            <div class="col-lg-8">
                <span>@controllo.Anomalia</span>
            </div>
            <div class="col-lg-1">
                <span>@controllo.NumeroRecord</span>
            </div>
            <div class="col-lg-1">
                <span>@controllo.UltimoAggiornamento.ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>
            <div class="col-lg-1 d-flex text-center justify-content-center">
                <a asp-action="Detail"
                   asp-route-id="@controllo.IdSource"
                   title="Visualizza dettagli">
                   <i class="fas fa-info-circle fa-lg"></i>
                </a>
            </div>
        </div>
    }
</div>