@model List<RevisioneViewModel>

<div class="row">
    <div class="col-md-8">
        <h2>@ViewData["Title"]</h2>
    </div>
</div>

@if (Model.Any()) // Se il Model contiene almeno un elemento
{
    <div class="d-flex justify-content-between align-items-center">
        <h4 class="mb-3 text-primary">@Model.First().Filtro</h4>
        <button onclick="window.history.back()" class="btn btn-outline-primary ml-auto">
            <i class="fa fa-arrow-left"></i> Indietro
        </button>
    </div>
}

<div class="row fw-bold text-white bg-primary p-2 rounded">
    <div class="col-md-6">Indicatori</div>
    <div class="col-md-3">Info</div>
    <div class="col-md-3">Note Istruttore</div>
</div>

@for (int i = 0; i < Model.Count; i++)
{
    var revisione = Model[i];
    var rowClass = revisione.Tipo_Colonna == 2 ? "bg-warning" : "";

    <div class="row border-bottom py-2 align-items-center @rowClass">
        <div class="col-md-6">
            <span>@revisione.NomeColonna</span>
        </div>
        @if (revisione.Tipo_Colonna != 2)
        {
            <div class="col-md-3 @(revisione.Info == "SI" || revisione.Info == "ACCESO" || revisione.Info == "Indicatore non rispettato" ? "text-danger fw-bold" : "")">
                <span>@Model[i].Info</span>
            </div>
            <div class="col-md-3 d-flex align-items-center justify-content-end">
                @Html.AntiForgeryToken()

                <input type="text"
                        class="form-control form-control-sm"
                        id="note-@i"
                        value="@revisione.NoteIstruttore" />
                <button type="button"
                        id="btn-salva-@i"
                        class="btn btn-outline-success btn-sm ms-2"
                        onclick="salvaNote('@revisione.Id', @i)">
                    <i class="fas fa-save"></i>
                </button>
            </div>
        }
    </div>
}

<div class="text-center">
    <button id="btnCreaPdf" type="button" class="btn btn-primary mt-3" data-nag="@Model.First().Nag_Affidato">
        <i class="fas fa-file-alt"></i>
        Crea PDF
    </button>
</div>

<div class="modal fade" id="campiMancantiModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Dati mancanti per la generazione del PDF
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <p>
                    Compilare le Note Istruttore per i seguenti Indicatori:
                </p>

                <ul id="campiMancantiList"></ul>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Chiudi
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function salvaNote(id, index) {
            const note = $('#note-' + index).val();
            const token = $('input[name="__RequestVerificationToken"]').val();
            const urlSalvataggio = '@Url.Action("SaveNote", "Revisioni")';

            console.log("Invio:", { Id: id, NoteIstruttore: note, Token: token });

            $.ajax({
                url: urlSalvataggio,
                method: 'POST',
                dataType: 'json',
                data: {
                    __RequestVerificationToken: token,
                    id: id,
                    noteIstruttore: note
                },
                success: function (response) {
                    alert(response.message);
                },
                error: function (xhr) {
                    try {
                        const response = JSON.parse(xhr.responseText);
                        alert(response.message || "Errore durante il salvataggio della nota.");
                    } catch (e) {
                        console.error("Errore AJAX:", xhr.responseText);
                        alert("Errore imprevisto.");
                    }
                }
            });
        }

        $("#btnCreaPdf").click(function () {

            const nag = $(this).data("nag");

            $.ajax({
                url: '@Url.Action("CreatePdf", "Revisioni")',
                type: 'POST',
                data: { nag },

                success: function (response) {
                    downloadPdf(response.pdf);
                },

                error: function (xhr) {

                    if (xhr.status === 400) {
                        mostraCampiMancanti(xhr.responseJSON.campi);
                    }
                }
            });
        });

        function downloadPdf(base64Pdf) {

            const bytes = Uint8Array.from(
                atob(base64Pdf),
                c => c.charCodeAt(0)
            );

            const blob = new Blob(
                [bytes],
                { type: "application/pdf" }
            );

            const url = URL.createObjectURL(blob);

            const link = document.createElement("a");

            link.href = url;
            link.download = "Report.pdf";
            link.click();

            URL.revokeObjectURL(url);
        }

        function mostraCampiMancanti(campi) {

            const lista = $("#campiMancantiList").empty();

            campi.forEach(campo => {
                lista.append(`<li>${campo}</li>`);
            });

            new bootstrap.Modal(
                document.getElementById("campiMancantiModal")
            ).show();
        }
    </script>
}